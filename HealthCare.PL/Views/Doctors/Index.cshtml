@model PaginatedList<DoctorViewModel>
@{ViewData["Title"]="Doctors";}<h1>Doctors</h1><p><a class="btn btn-primary" asp-action="Create">Create New</a></p><form method="get" class="row g-2 mb-3"><div class="col-auto"><input name="searchValue" value="@ViewBag.SearchValue" class="form-control" placeholder="Search by name"/></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form><table class="table table-striped"><thead><tr><th>Name</th><th>Specialization</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Name</td><td>@item.Specialization</td><td><a asp-action="Details" asp-route-id="@item.Id">Details</a> | <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> | <a asp-action="Delete" asp-route-id="@item.Id">Delete</a></td></tr>}</tbody></table><div class="d-flex gap-2">@if(Model.HasPreviousPage){<a class="btn btn-outline-primary" asp-route-pageIndex="@(Model.PageIndex-1)" asp-route-searchValue="@ViewBag.SearchValue">Previous</a>}<span class="align-self-center">Page @Model.PageIndex of @Model.TotalPages</span>@if(Model.HasNextPage){<a class="btn btn-outline-primary" asp-route-pageIndex="@(Model.PageIndex+1)" asp-route-searchValue="@ViewBag.SearchValue">Next</a>}</div>