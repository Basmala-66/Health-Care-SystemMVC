@model DoctorViewModel
@{ViewData["Title"]="Delete Doctor";}<h1>Delete Doctor</h1><p>Are you sure you want to delete this doctor?</p><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Specialization</dt><dd class="col-sm-9">@Model.Specialization</dd></dl><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>