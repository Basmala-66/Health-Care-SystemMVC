@model PaginatedList<Health_Care_System.Entities.Appointment>
@{ViewData["Title"]="Appointments";}<h1>Appointments</h1><p><a asp-action="Create" class="btn btn-primary">Create New</a></p><form method="get" class="row g-2 mb-3"><div class="col-auto"><input name="searchValue" value="@ViewBag.SearchValue" class="form-control" placeholder="Search patient or doctor"/></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div></form><table class="table table-striped"><thead><tr><th>Patient</th><th>Doctor</th><th>Date</th><th></th></tr></thead><tbody>@foreach(var item in Model){<tr><td>@item.Patient?.Name</td><td>@item.Doctor?.Name</td><td>@item.AppointmentDate</td><td><a asp-action="Details" asp-route-patientId="@item.PatientId" asp-route-doctorId="@item.DoctorId">Details</a> | <a asp-action="Edit" asp-route-patientId="@item.PatientId" asp-route-doctorId="@item.DoctorId">Edit</a> | <a asp-action="Delete" asp-route-patientId="@item.PatientId" asp-route-doctorId="@item.DoctorId">Delete</a></td></tr>}</tbody></table><div class="d-flex gap-2">@if(Model.HasPreviousPage){<a class="btn btn-outline-primary" asp-route-pageIndex="@(Model.PageIndex-1)" asp-route-searchValue="@ViewBag.SearchValue">Previous</a>}<span class="align-self-center">Page @Model.PageIndex of @Model.TotalPages</span>@if(Model.HasNextPage){<a class="btn btn-outline-primary" asp-route-pageIndex="@(Model.PageIndex+1)" asp-route-searchValue="@ViewBag.SearchValue">Next</a>}</div>