@model PatientViewModel
@{ViewData["Title"]="Delete Patient";}<h1>Delete Patient</h1><p>Are you sure you want to delete this patient?</p><dl class="row"><dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.Name</dd><dt class="col-sm-3">Birth Date</dt><dd class="col-sm-9">@Model.BirthDate</dd></dl><form asp-action="Delete" method="post"><input type="hidden" asp-for="Id"/><button type="submit" class="btn btn-danger">Delete</button> <a asp-action="Index" class="btn btn-secondary">Cancel</a></form>